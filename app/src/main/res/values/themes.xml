    <style name="Theme.MyApplication" parent="Base.Theme.MyApplication" />

    <!-- 圆角对话框样式 -->
    <style name="RoundedDialogTheme" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_dialog_rounded</item>
        <!-- 强制减小最小宽度，使其更紧凑 -->

<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/chat_drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.ChatActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/white">

        <!-- Simple Top Bar with only icons -->

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="16dp"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Menu Button (Right) -->
            <ImageView
                android:id="@+id/iv_menu"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:padding="12dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="7dp"
                android:src="@drawable/ic_menu"
                app:tint="@color/black"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:contentDescription="menu-button" />

            <!-- New Chat Button (Left of Menu) -->
            <ImageView
                android:id="@+id/ic_new_chat"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:padding="10dp"
                android:src="@drawable/ic_new_chat"
                app:layout_constraintBottom_toBottomOf="@id/iv_menu"
                app:layout_constraintEnd_toStartOf="@id/iv_menu"
                app:layout_constraintTop_toTopOf="@id/iv_menu"
                android:contentDescription="new-chat" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipe_refresh_layout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@id/bottom_chat_input_area"
            app:layout_constraintTop_toBottomOf="@id/layout_header"
            app:layout_constraintVertical_bias="1.0">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/chat_messages_recyclerview"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <!-- Bottom Chat Input Area -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/bottom_chat_input_area"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/white"
            android:elevation="4dp"
            android:paddingTop="8dp"
            app:layout_constraintBottom_toBottomOf="parent">

            <LinearLayout
                android:id="@+id/network_search_layout_chat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_web_search_button"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingTop="4dp"
                android:paddingEnd="8dp"
                android:paddingBottom="4dp"
                app:layout_constraintBottom_toTopOf="@+id/chat_input_row_container"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_earth"
                    android:contentDescription="@string/content_description_network_search_icon" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="@string/network_search"
                    android:textColor="@android:color/black"
                    android:textSize="14sp" />

            </LinearLayout>

            <ImageView
                android:id="@+id/more_options_icon_chat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:src="@drawable/ic_more_horiz_24"
                android:contentDescription="@string/content_description_more_options_icon"
                android:background="@drawable/rounded_corner_white_background"
                app:layout_constraintBottom_toTopOf="@+id/chat_input_row_container"
                app:layout_constraintStart_toEndOf="@id/network_search_layout_chat"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.5"
                android:layout_marginBottom="8dp" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/chat_input_row_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/rounded_corner_gray_background"
                android:layout_marginBottom="12dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@id/network_search_layout_chat">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvPreview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toTopOf="@+id/input_barrier"
                    tools:listitem="@layout/item_media_preview"
                    tools:visibility="visible"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>

                <ImageButton
                    android:id="@+id/chat_add_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="9dp"
                    android:layout_marginEnd="10dp"
                    android:padding="5dp"
                    android:background="@android:color/transparent"
                    android:src="@drawable/outline_add_circle_24"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/chat_send_stop_container"
                    android:contentDescription="content_description_add_document_icon" />

                <ImageView
                    android:id="@+id/chat_document_list_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginBottom="9dp"
                    android:padding="5dp"
                    android:contentDescription="@string/content_description_document_list_icon"
                    android:src="@drawable/ic_keyboard"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"  />

                <TextView
                    android:id="@+id/chat_hold_to_speak_button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="4dp"
                    android:layout_marginBottom="4dp"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:text="@string/hold_to_speak"
                    android:textColor="@android:color/black"
                    android:textSize="16sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/chat_add_button"
                    app:layout_constraintHeight_min="48dp"
                    app:layout_constraintStart_toEndOf="@id/chat_document_list_icon" />

                <EditText
                    android:id="@+id/chat_message_input_edittext"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:hint="@string/chat_input_hint"
                    android:inputType="textMultiLine"
                    android:background="@drawable/rounded_corner_gray_background"
                    android:maxLines="5"
                    android:layout_marginStart="2dp"
                    android:paddingStart="14dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="14dp"
                    android:textColor="@android:color/black"
                    android:textColorHint="@android:color/darker_gray"
                    android:textSize="16sp"
                    android:visibility="gone"
                    app:layout_constraintBottom_toTopOf="@+id/chat_send_stop_container"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="@id/chat_send_stop_container"
                    app:layout_constraintHeight_min="48dp" />

                <FrameLayout
                    android:id="@+id/chat_send_stop_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:layout_marginBottom="9dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <ImageView
                        android:id="@+id/chat_send_button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="5dp"
                        android:src="@drawable/send_24px"
                        android:contentDescription="@string/content_description_send_button" />

                    <ImageView
                        android:id="@+id/iv_stop"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_media_pause"
                        android:padding="5dp"
                        app:tint="#8F959E"
                        android:visibility="gone"
                        android:contentDescription="Stop"/>
                </FrameLayout>

                <androidx.constraintlayout.widget.Barrier
                    android:id="@+id/input_barrier"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:barrierDirection="top"
                    app:constraint_referenced_ids="chat_message_input_edittext,chat_document_list_icon,chat_hold_to_speak_button,chat_add_button,chat_send_stop_container" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Sidebar -->
    <LinearLayout
        android:id="@+id/nav_drawer_layout"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@color/white"
        android:orientation="vertical"
        android:clickable="true"
        android:focusable="true"
        android:paddingTop="48dp">

        <!-- Create New Chat -->
        <TextView
            android:id="@+id/btn_new_chat"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:paddingStart="24dp"
            android:paddingEnd="16dp"
            android:text="创建新聊天"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textStyle="bold"
            android:drawablePadding="16dp"
            app:drawableStartCompat="@drawable/ic_new_chat"
            android:background="?attr/selectableItemBackground" />

        <!-- Knowledge Base -->
        <TextView
            android:id="@+id/btn_knowledge_base"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:paddingStart="24dp"
            android:paddingEnd="16dp"
            android:text="我的知识库"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textStyle="bold"
            android:drawablePadding="16dp"
            app:drawableStartCompat="@drawable/ic_book"
            android:background="?attr/selectableItemBackground" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:background="#F0F0F0" />

        <!-- History Section Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="24dp"
            android:paddingTop="12dp"
            android:paddingBottom="8dp"
            android:text="历史对话"
            android:textColor="#8F959E"
            android:textSize="14sp" />

        <!-- History List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/history_recyclerview"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="vertical"
            android:overScrollMode="never" />

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>

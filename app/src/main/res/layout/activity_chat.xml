<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/chat_drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.ChatActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/white">

        <!-- Messages List -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Menu Button (Right) -->
            <ImageView
                android:id="@+id/iv_menu"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="7dp"
                android:contentDescription="@string/content_description_menu_button"
                android:padding="8dp"
                android:src="@drawable/ic_menu"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/black" />

            <!-- New Chat Button (Left of Menu) -->
            <ImageView
                android:id="@+id/ic_new_chat"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:contentDescription="@string/content_description_new_chat"
                android:padding="8dp"
                android:src="@drawable/ic_new_chat"
                app:layout_constraintBottom_toBottomOf="@id/iv_menu"
                app:layout_constraintEnd_toStartOf="@id/iv_menu"
                app:layout_constraintTop_toTopOf="@id/iv_menu" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipe_refresh_layout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@id/chat_input_view"
            app:layout_constraintTop_toBottomOf="@id/layout_header">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/chat_messages_recyclerview"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>


        <!-- Web Search & Model Switch -->
        <com.example.myapplication.ui.widget.ChatInputView
            android:id="@+id/chat_input_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Sidebar -->
    <LinearLayout
        android:id="@+id/nav_drawer_layout"
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@color/sidebar_background"
        android:orientation="vertical"
        android:clickable="true"
        android:focusable="true"
        android:paddingTop="0dp">

        <include
            android:id="@+id/include_sidebar"
            layout="@layout/include_sidebar_common" />

        <!-- History List (Fragment) -->
        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/history_fragment_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:name="com.example.myapplication.ui.HistoryFragment" />

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/chat_drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.ChatActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/white">

        <!-- Messages List -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Menu Button (Right) -->
            <ImageView
                android:id="@+id/iv_menu"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="7dp"
                android:contentDescription="@string/content_description_menu_button"
                android:padding="8dp"
                android:src="@drawable/ic_menu"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/black" />

            <!-- New Chat Button (Left of Menu) -->
            <ImageView
                android:id="@+id/ic_new_chat"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:contentDescription="@string/content_description_new_chat"
                android:padding="8dp"
                android:src="@drawable/ic_new_chat"
                app:layout_constraintBottom_toBottomOf="@id/iv_menu"
                app:layout_constraintEnd_toStartOf="@id/iv_menu"
                app:layout_constraintTop_toTopOf="@id/iv_menu" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipe_refresh_layout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@id/layout_web_search"
            app:layout_constraintTop_toBottomOf="@id/layout_header">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/chat_messages_recyclerview"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>


        <!-- Input Area (Copied structure from activity_main.xml) -->

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_web_search"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="16dp"
            android:background="@drawable/bg_web_search_button"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="10dp"
            app:layout_constraintBottom_toTopOf="@+id/layout_input"
            app:layout_constraintStart_toStartOf="parent">

            <ImageView
                android:id="@+id/iv_web_search_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@string/content_description_web_search_icon"
                android:src="@drawable/ic_earth"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tv_web_search_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/web_search_text"
                android:textColor="@color/black"
                android:textSize="14sp"
                android:textStyle="normal"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/iv_web_search_icon"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <ImageView
            android:id="@+id/iv_more_icon"
            android:layout_width="38dp"
            android:layout_height="35dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_more_circle"
            app:layout_constraintBottom_toTopOf="@+id/layout_input"
            app:layout_constraintStart_toEndOf="@+id/layout_web_search"
            app:layout_constraintTop_toTopOf="@+id/layout_web_search"
            app:layout_constraintVertical_bias="1.0" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="6dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <!-- Preview List for Images/Files -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_preview"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:orientation="horizontal"
                android:visibility="gone"
                app:layout_constraintBottom_toTopOf="@+id/input_box_container"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginBottom="8dp"/>

            <!-- Input Box -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/input_box_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input_box"
                android:minHeight="50dp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:layout_marginBottom="12dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <!-- Left: Mic/Keyboard Button -->
                <ImageView
                    android:id="@+id/iv_mic"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_mic"
                    app:tint="@android:color/black"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    android:contentDescription="@string/content_description_voice" />

                <!-- Middle: Input Text Box -->
                <EditText
                    android:id="@+id/et_input"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:background="@null"
                    android:hint="@string/input_hint"
                    android:textColor="@color/black"
                    android:textColorHint="#8F959E"
                    android:textSize="16sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/iv_more"
                    app:layout_constraintStart_toEndOf="@+id/iv_mic"
                    app:layout_constraintTop_toTopOf="parent"
                    android:inputType="textMultiLine"
                    android:maxLines="4"
                    android:autofillHints="" />
                
                <!-- Hold to speak mode -->
                <TextView
                    android:id="@+id/tv_hold_to_speak"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:gravity="center"
                    android:text="@string/mic_hint"
                    android:textColor="#8F959E"
                    android:textSize="16sp"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/iv_more"
                    app:layout_constraintStart_toEndOf="@+id/iv_mic"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Right: Upload Picture Button -->
                <ImageView
                    android:id="@+id/iv_more"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="12dp"
                    android:src="@drawable/ic_upload_picture"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/divider_send"
                    app:layout_constraintTop_toTopOf="parent"
                    android:contentDescription="@string/content_description_add" />

                <!-- Divider between More Button and Send Button -->
                <View
                    android:id="@+id/divider_send"
                    android:layout_width="1dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="8dp"
                    android:background="#8F959E"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/layout_send_stop"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Send/Stop Button Container -->
                <FrameLayout
                    android:id="@+id/layout_send_stop"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:id="@+id/iv_send"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_send"
                        app:tint="#8F959E"
                        android:layout_gravity="center"
                        android:contentDescription="@string/content_description_send" />

                    <ImageView
                        android:id="@+id/iv_stop"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:padding="2dp"
                        android:src="@drawable/ic_media_pause"
                        app:tint="#000000"
                        android:visibility="gone"
                        android:layout_gravity="center"
                        android:contentDescription="@string/content_description_stop" />
                </FrameLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Sidebar -->
    <LinearLayout
        android:id="@+id/nav_drawer_layout"
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@color/sidebar_background"
        android:orientation="vertical"
        android:clickable="true"
        android:focusable="true"
        android:paddingTop="0dp"
        android:fitsSystemWindows="false"
        tools:ignore="UselessLeaf">

        <!-- Sidebar Header: Logo and Search -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="32dp"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="飞书知识问答"
                android:textColor="@color/black"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/btn_sidebar_search"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_search"
                app:tint="@color/black"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="搜索" />
        </LinearLayout>

        <!-- Create New Chat -->
        <TextView
            android:id="@+id/btn_new_chat"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="4dp"
            android:paddingHorizontal="16dp"
            android:gravity="center_vertical"
            android:text="@string/menu_create_new_chat"
            android:textColor="@color/black"
            android:textSize="15sp"
            android:drawablePadding="12dp"
            app:drawableStartCompat="@drawable/ic_new_chat"
            android:background="@drawable/bg_sidebar_button" />

        <!-- Knowledge Base -->
        <TextView
            android:id="@+id/btn_knowledge_base"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="8dp"
            android:paddingHorizontal="16dp"
            android:gravity="center_vertical"
            android:text="@string/menu_my_knowledge_base"
            android:textColor="@color/black"
            android:textSize="15sp"
            android:drawablePadding="12dp"
            app:drawableStartCompat="@drawable/ic_book"
            android:background="@drawable/bg_sidebar_button" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="4dp"
            android:background="#EEEEEE" />

        <!-- History Section Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="24dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="@string/menu_history_dialogue"
            android:textColor="#8F959E"
            android:textSize="14sp" />

        <!-- History List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/history_recyclerview"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="vertical"
            android:overScrollMode="never" />

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>

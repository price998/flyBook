<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:openDrawer="start"
    tools:context=".ui.DialogueActivity">

    <!-- Main Content -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white">

        <!-- ========== Header Section ========== -->
        <!-- Menu Button (Top Right) -->
        <ImageView
            android:id="@+id/iv_menu"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginTop="30dp"
            android:layout_marginEnd="3dp"
            android:contentDescription="@string/content_description_menu_button"
            android:padding="6dp"
            android:src="@drawable/ic_menu"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/black" />

        <!-- Web Search Toggle Button -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_web_search"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="16dp"
            android:background="@drawable/bg_web_search_button"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="10dp"
            app:layout_constraintBottom_toTopOf="@+id/layout_input"
            app:layout_constraintStart_toStartOf="parent">

            <ImageView
                android:id="@+id/iv_web_search_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@string/content_description_web_search_icon"
                android:src="@drawable/ic_earth"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tv_web_search_text"
                android:layout_width="62dp"
                android:layout_height="19dp"
                android:layout_marginStart="8dp"
                android:text="@string/web_search_text"
                android:textColor="@color/black"
                android:textSize="14sp"
                android:textStyle="normal"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/iv_web_search_icon"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- More Options Button (Right of Web Search) -->
        <ImageView
            android:id="@+id/iv_more_icon"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:layout_marginStart="8dp"
            android:contentDescription="@string/content_description_more_model_options"
            android:src="@drawable/ic_more_circle"
            app:layout_constraintBottom_toTopOf="@+id/layout_input"
            app:layout_constraintStart_toEndOf="@+id/layout_web_search"
            app:layout_constraintTop_toTopOf="@+id/layout_web_search" />

        <!-- ========== Center Content Section ========== -->
        <!-- Logo -->
        <ImageView
            android:id="@+id/iv_logo"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/newlogo"
            app:layout_constraintBottom_toTopOf="@+id/tv_main_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/iv_menu"
            app:layout_constraintVertical_chainStyle="packed"
            app:layout_constraintVertical_bias="0.3"
            android:contentDescription="@string/content_description_logo" />

        <!-- Main Title -->
        <TextView
            android:id="@+id/tv_main_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/main_title"
            android:textColor="@color/black"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@+id/tv_main_subtitle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.498"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/iv_logo" />

        <!-- Subtitle under Main Title -->
        <TextView
            android:id="@+id/tv_main_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/main_subtitle"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            app:layout_constraintBottom_toTopOf="@+id/topic_recyclerview"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_main_title" />

        <!-- Recommended Topics RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/topic_recyclerview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:clipToPadding="false"
            android:paddingHorizontal="16dp"
            android:paddingBottom="16dp"
            app:layout_constraintBottom_toTopOf="@+id/layout_web_search"
            app:layout_constraintTop_toBottomOf="@+id/tv_main_subtitle" />

        <!-- ========== Bottom Section ========== -->
        <!-- Input Area -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="6dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <!-- Input Box -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input_box"
                android:minHeight="50dp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:layout_marginBottom="12dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <!-- Left: Mic/Keyboard Button -->
                <ImageView
                    android:id="@+id/iv_mic"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_mic"
                    app:tint="@android:color/black"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    android:contentDescription="@string/content_description_voice" />

                <!-- Middle: Input Text Box -->
                <EditText
                    android:id="@+id/et_input"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:background="@null"
                    android:hint="@string/input_hint"
                    android:textColor="@color/black"
                    android:textColorHint="#8F959E"
                    android:textSize="16sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/iv_more"
                    app:layout_constraintStart_toEndOf="@+id/iv_mic"
                    app:layout_constraintTop_toTopOf="parent"
                    android:inputType="textMultiLine"
                    android:maxLines="4"
                    android:autofillHints="" />

                <!-- Hold to speak mode -->
                <TextView
                    android:id="@+id/tv_hold_to_speak"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:gravity="center"
                    android:text="@string/mic_hint"
                    android:textColor="#8F959E"
                    android:textSize="16sp"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/iv_more"
                    app:layout_constraintStart_toEndOf="@+id/iv_mic"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Right: Upload Picture Button -->
                <ImageView
                    android:id="@+id/iv_more"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="12dp"
                    android:src="@drawable/ic_upload_picture"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/divider_send"
                    app:layout_constraintTop_toTopOf="parent"
                    android:contentDescription="@string/content_description_add" />

                <!-- Divider between More Button and Send Button -->
                <View
                    android:id="@+id/divider_send"
                    android:layout_width="1dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="8dp"
                    android:background="#8F959E"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/iv_send"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Send Button -->
                <ImageView
                    android:id="@+id/iv_send"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="12dp"
                    android:src="@drawable/ic_send"
                    app:tint="#8F959E"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    android:contentDescription="@string/content_description_send" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Sidebar -->
    <LinearLayout
        android:id="@+id/nav_drawer_layout"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@color/white"
        android:orientation="vertical"
        android:clickable="true"
        android:focusable="true"
        android:paddingTop="48dp">

        <!-- Create New Chat -->
        <TextView
            android:id="@+id/btn_new_chat"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:paddingStart="24dp"
            android:paddingEnd="16dp"
            android:text="@string/menu_create_new_chat"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textStyle="bold"
            android:drawablePadding="16dp"
            app:drawableStartCompat="@drawable/ic_new_chat"
            android:background="?attr/selectableItemBackground" />

        <!-- Knowledge Base -->
        <TextView
            android:id="@+id/btn_knowledge_base"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:paddingStart="24dp"
            android:paddingEnd="16dp"
            android:text="@string/menu_my_knowledge_base"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textStyle="bold"
            android:drawablePadding="16dp"
            app:drawableStartCompat="@drawable/ic_book"
            android:background="?attr/selectableItemBackground" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:background="#F0F0F0" />

        <!-- History Section Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="24dp"
            android:paddingTop="12dp"
            android:paddingBottom="8dp"
            android:text="@string/menu_history_dialogue"
            android:textColor="#8F959E"
            android:textSize="14sp" />

        <!-- History List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/history_recyclerview"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="vertical"
            android:overScrollMode="never" />

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>